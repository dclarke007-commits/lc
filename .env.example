# --- Database (managed Postgres 16, transaction-mode pooling) ---
# App/runtime connects through the POOLED (pgBouncer transaction-mode) string (AD-3).
# Local dev: pgBouncer from docker-compose.yml on :6432.
# Prod (Vercel): the provider's pooled connection string (Neon/Supabase pgBouncer).
DATABASE_URL="postgres://loves:loves@localhost:6432/lovescleaning"

# Direct (non-pooled) connection — used ONLY by drizzle-kit for migrations/DDL.
# Local dev: Postgres directly on :5432. Prod: the provider's direct/unpooled URL.
DIRECT_URL="postgres://loves:loves@localhost:5432/lovescleaning"

# --- Operator seed (one-row owner, AD-8) ---
OPERATOR_EMAIL="operator@example.com"
OPERATOR_PASSPHRASE="change-me-to-a-long-random-passphrase"

# --- Session cookie signing (HMAC-SHA256, node/web crypto) ---
# Use a long random secret (>= 32 chars). Rotate invalidates all sessions.
SESSION_SECRET="change-me-to-a-long-random-32char-plus-secret"

# --- Per-client booking token signing (HMAC-SHA256; Story 3.1, AD-6) ---
# Signs the unguessable per-client booking links (app/book/[token]). A DISTINCT
# secret from SESSION_SECRET (key separation). Use a long random secret (>= 32
# chars). MUST be set in prod: if unset/weak, every client booking link fails
# closed to a generic invalid-link (no login exists to fall back on, FR34).
CLIENT_TOKEN_SECRET="change-me-to-a-long-random-32char-plus-secret"

# --- App base URL (Story 3.3) ---
# Absolute origin used to build client-facing booking links in composed messages
# (e.g. rebooking nudges: ${APP_BASE_URL}/book/<token>). A trailing slash is stripped.
# REQUIRED in production: if unset when NODE_ENV=production the rebooking proposal fails
# closed (base-url-unset) rather than emit a localhost link to a real client. In dev/test
# an unset value defaults to http://localhost:3000.
APP_BASE_URL="http://localhost:3000"
